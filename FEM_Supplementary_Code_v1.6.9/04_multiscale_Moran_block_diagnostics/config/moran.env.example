# Copy to a private file, edit paths and block sizes, then run:
# CONFIG_FILE=/absolute/path/moran.env ./run_multiscale_moran_only_dual_periods.sh

PROJECT_DIR=/absolute/path/to/FEM_Supplementary_Code_v1.6.3/04_multiscale_Moran_block_diagnostics
OUTPUT_ROOT=/absolute/path/to/project/output
PYTHON_BIN=python3

PERIODS=2001-2020,2005-2020
ONLY=30m,100m,250m,500m,1km,5km,10km,25km,50km,75km,100km

# Main analysis: all valid TrendSlope pixels, no MK-p/q threshold.
USE_SIGNIFICANCE_MASK=0
USE_FDR=0
SLOPE_INPUT_SCALE=1
# Module 08 exports unscaled floating-point Sen slopes. Use 100 only for legacy encoded inputs.
AGGREGATE_EDGE_MODE=partial
AGGREGATE_MIN_VALID_FRACTION=0
NEIGHBOR=queen
KERNEL_RADIUS=1
N_PERMUTATIONS=0
SEED=42
MIN_MORAN_PIXELS=30
SMALL_MORAN_SAMPLE_ACTION=point-only

# Publication default: 2,000 bootstrap replicates; reduce only for debugging.
N_SPATIAL_BOOTSTRAP=2000
BOOTSTRAP_BLOCK_WORKERS=1
BOOTSTRAP_WORKERS=1
BOOTSTRAP_CI_LEVEL=0.95
BOOTSTRAP_EDGE_MODE=balanced
BOOTSTRAP_MIN_USABLE_BLOCKS=20
BOOTSTRAP_MAX_PARTITION_DIFFERENCE=0.05
BOOTSTRAP_MAX_VALID_PIXEL_CV=0.50
BOOTSTRAP_SAVE_DISTRIBUTION=1

# Fill only after block sizes have been selected. Values are cells after aggregation.
BOOTSTRAP_BLOCK_CELLS_BY_SCALE=

FORCE=0
FAIL_FAST=1
LOG_LEVEL=INFO
DISABLE_RUN_LOCK=0
